# Keep the real Spreadsheet ID only in local or deployment secrets.
GOOGLE_SPREADSHEET_ID=your-spreadsheet-id

# Choose one authentication method.
# 1) Local service-account JSON path
GOOGLE_SERVICE_ACCOUNT_FILE=C:/path/to/service-account.json

# 2) Or the entire service-account JSON object (useful for hosted environments)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

CACHE_TTL_SECONDS=120
APP_TIMEZONE=Asia/Seoul
